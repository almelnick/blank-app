# ------------------------------------------------------------------
# Server
# ------------------------------------------------------------------
PORT=3000

# ------------------------------------------------------------------
# OpenAI
# ------------------------------------------------------------------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini
# Optional. Model used for RAG embeddings. Defaults to text-embedding-3-small.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional. System prompt that defines the assistant's behaviour.
AI_SYSTEM_PROMPT=You are a helpful assistant for a company. Answer in the customer's language, be concise and friendly.

# ------------------------------------------------------------------
# Brain settings (memory + knowledge base)
# ------------------------------------------------------------------
# Conversation turns kept in memory per contact (1 turn = user + assistant).
MEMORY_MAX_TURNS=10
# Folder with .md/.txt files used as the RAG knowledge base.
KNOWLEDGE_DIR=knowledge
# How many knowledge chunks to inject into each answer.
KNOWLEDGE_TOP_K=4

# ------------------------------------------------------------------
# WhatsApp Cloud API (Meta)
# https://developers.facebook.com/docs/whatsapp/cloud-api
# ------------------------------------------------------------------
# Permanent or temporary access token from the Meta app.
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxx
# Phone number ID of the WhatsApp business number.
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Token you invent; you must paste the same value in the Meta webhook config.
WHATSAPP_VERIFY_TOKEN=my-very-secret-verify-token
# Optional. Graph API version. Defaults to v20.0.
WHATSAPP_API_VERSION=v20.0
# App secret from the Meta dashboard. Used to verify webhook/flow signatures.
WHATSAPP_APP_SECRET=

# ------------------------------------------------------------------
# WhatsApp Flows (encrypted endpoint) — optional
# Generate the keys with: node scripts/generate-flow-keys.mjs
# ------------------------------------------------------------------
# RSA private key as a single line, using \n for line breaks.
WHATSAPP_FLOW_PRIVATE_KEY=
# Only if you generated the key with a passphrase.
WHATSAPP_FLOW_PRIVATE_KEY_PASSPHRASE=

# ------------------------------------------------------------------
# Twenty CRM
# https://twenty.com  /  Settings > APIs & Webhooks
# ------------------------------------------------------------------
# Base URL of your Twenty instance API (no trailing slash).
TWENTY_API_URL=https://api.twenty.com
# API key generated in Twenty (Settings > API & Webhooks).
TWENTY_API_KEY=eyJhbGcixxxxxxxxxxxxxxxx
