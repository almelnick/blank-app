{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "▶ Run server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/index.js",
      "envFile": "${workspaceFolder}/.env",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      "name": "🐞 Debug server (watch)",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["--watch"],
      "program": "${workspaceFolder}/src/index.js",
      "envFile": "${workspaceFolder}/.env",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    }
  ]
}
